# Puzzel Environment Variables
# Copy this file to .env and fill in your values.

# Server settings
PUZZEL_HOST=0.0.0.0
PUZZEL_PORT=8000

# Checkpoint path (defaults to checkpoints/multilingual-first-run.best.pt)
PUZZEL_CHECKPOINT=checkpoints/multilingual-first-run.best.pt

# Authentication (set PUZZEL_AUTH_ENABLED=true to enable API key auth)
PUZZEL_AUTH_ENABLED=false

# Device selection: cpu, cuda, mps, or auto
PUZZEL_DEVICE=auto

# Inference settings
PUZZEL_MAX_CONTEXT_LENGTH=512
PUZZEL_MAX_BATCH_SIZE=1
PUZZEL_USE_KV_CACHE=true
PUZZEL_USE_HALF_PRECISION=false

# Rate limiting
PUZZEL_RATE_LIMIT_MAX_REQUESTS=60
PUZZEL_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
PUZZEL_LOG_LEVEL=INFO