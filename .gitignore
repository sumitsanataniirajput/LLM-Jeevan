!/data/raw/README.md
!/data/raw/en/
/data/raw/en/*
!/data/raw/en/.gitkeep
!/data/raw/hi/
/data/raw/hi/*
!/data/raw/hi/.gitkeep
!/data/raw/es/
/data/raw/es/*
!/data/raw/es/.gitkeep
