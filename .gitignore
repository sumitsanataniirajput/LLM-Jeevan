/data/raw/fr/*
!/data/raw/fr/.gitkeep
!/data/raw/ar/
/data/raw/ar/*
!/data/raw/ar/.gitkeep
!/data/raw/zh/
/data/raw/zh/*
!/data/raw/zh/.gitkeep
/data/processed/*
!/data/processed/README.md
!/data/processed/multilingual-v1/
/data/processed/multilingual-v1/*
!/data/processed/multilingual-v1/.gitkeep
/data/reports/*
!/data/reports/.gitkeep
/data/evaluation/*
!/data/evaluation/README.md
