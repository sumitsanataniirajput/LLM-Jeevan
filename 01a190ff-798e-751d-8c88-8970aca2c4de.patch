+            try:
+                value = float(raw)
+            except (TypeError, ValueError):
+                raise EvaluationDatasetError(
+                    f"training metrics column {field!r} contains a non-numeric value"
+                ) from None
+            if not math.isfinite(value) or value < 0:
+                raise EvaluationDatasetError(
+                    f"training metrics column {field!r} contains an invalid loss"
+                )
+            return value
+        return None
+
+    train_loss = latest_value("train_loss", allow_blank=False)
+    validation_loss = latest_value("validation_loss", allow_blank=True)
+    return {
+        "source_sha256": _sha256_file(source),
+        "train_loss": train_loss,
+        "train_perplexity": finite_perplexity(train_loss),
+        "validation_loss": validation_loss,
+        "validation_perplexity": finite_perplexity(validation_loss),
+    }
+
+
+def _add_human_scores(
+    accumulator: dict[str, Any],
+    scores: list[float],
+) -> None:
+    accumulator["human_score_sum"] += sum(scores)
+    accumulator["human_score_count"] += len(scores)
+
+
+def evaluate_checkpoint(
+    checkpoint_path: str | Path,
+    dataset_path: str | Path,
+    suite_name: str,
+    *,
+    device_name: str = "cpu",
+    max_examples: int | None = None,
+    max_new_tokens: int | None = None,
+    training_metrics_path: str | Path | None = None,
+    human_ratings_path: str | Path | None = None,
+    code_sandbox: CodeSandboxCommand | None = None,
+) -> dict[str, Any]:
+    """Evaluate one existing Puzzel checkpoint on one licensed local JSONL suite."""
+    if max_examples is not None and (
+        not isinstance(max_examples, int)
+        or isinstance(max_examples, bool)
+        or max_examples <= 0
+    ):
+        raise ValueError("max_examples must be a positive integer when provided")
+    suite = load_suite_spec(suite_name)
+    if code_sandbox is not None and not suite.requires_code_sandbox:
+        raise ValueError(f"suite {suite.name!r} does not accept a code sandbox")
+    resolved_device = resolve_device(device_name)
+    checkpoint_source = Path(checkpoint_path)
+    dataset_source = Path(dataset_path)
+    loaded: LoadedCheckpoint = load_checkpoint(checkpoint_source, map_location="cpu")
+    model = loaded.model.to(resolved_device)
+    model.eval()
+    tokenizer = loaded.tokenizer
+    requested_new_tokens = suite.max_new_tokens if max_new_tokens is None else max_new_tokens
+    if (
+        not isinstance(requested_new_tokens, int)
+        or isinstance(requested_new_tokens, bool)
+        or requested_new_tokens <= 0
+    ):
+        raise ValueError("max_new_tokens must be a positive integer")
+
+    if max_examples is not None and human_ratings_path is not None:
+        raise ValueError("human ratings require the complete suite; omit --max-examples")
+    ratings = _load_human_ratings(human_ratings_path, suite)
+    accumulators: dict[str, dict[str, Any]] = {"overall": _empty_accumulator()}
+    valid_ids: set[str] = set()
+    per_example: list[dict[str, Any]] = []
+    total = 0
+    records = iter_evaluation_records(dataset_source, suite)
+    if max_examples is not None:
+        records = islice(records, max_examples)
+    for record in records:
+        example_id = record["id"]
+        valid_ids.add(example_id)
+        language = record["language"]
+        accumulator = accumulators["overall"]
+        language_accumulator = accumulators.setdefault(language, _empty_accumulator())
+        prompt = build_prompt(record, suite)
+        generated = greedy_generate(
+            model,
+            tokenizer,
+            prompt,
+            device=resolved_device,
+            max_new_tokens=requested_new_tokens,
+        )
+        references = _references(record, suite)
+        reference = references[0] if references else None
+        nll_sum = 0.0
+        scored_tokens = 0
+        if reference is not None:
+            nll_sum, scored_tokens = conditional_token_loss(
+                model,
+                tokenizer,
+                prompt,
+                reference,
+                device=resolved_device,
+            )
+
+        row: dict[str, Any] = {
+            "id": example_id,
+            "partition": record["partition"],
+            "language": language,
+            "scored_tokens": scored_tokens,
+            "conditional_nll": nll_sum / scored_tokens if scored_tokens else None,
+            "perplexity": finite_perplexity(nll_sum / scored_tokens) if scored_tokens else None,
+            "exact_match": None,
+            "chrf": None,
+            "nonempty": bool(generated.strip()),
+            "code_execution_ok": None,
+            "unit_test_pass_rate": None,
+            "sandbox_status": "not_run" if suite.requires_code_sandbox else None,
+            "human_rubric_mean": None,
+        }
+        accumulator["examples"] += 1
+        accumulator["partition_counts"][record["partition"]] += 1
+        language_accumulator["examples"] += 1
+        language_accumulator["partition_counts"][record["partition"]] += 1
+        if generated.strip():
+            accumulator["nonempty_examples"] += 1
+            language_accumulator["nonempty_examples"] += 1
+        if reference is not None:
+            accumulator["reference_examples"] += 1
+            language_accumulator["reference_examples"] += 1
+            accumulator["nll_sum"] += nll_sum
+            language_accumulator["nll_sum"] += nll_sum
+            accumulator["scored_tokens"] += scored_tokens
+            language_accumulator["scored_tokens"] += scored_tokens
+            exact = exact_match(generated, references) if "exact_accuracy" in suite.metric_directions else None
+            score = (
+                max(chrf_score(generated, candidate) for candidate in references)
+                if "chrf" in suite.metric_directions
+                else None
+            )
+            row["exact_match"] = exact
+            row["chrf"] = score
+            if exact is not None:
+                accumulator["exact_examples"] += 1
+                language_accumulator["exact_examples"] += 1
+                if exact:
+                    accumulator["exact_matches"] += 1
+                    language_accumulator["exact_matches"] += 1
+            if score is not None:
+                accumulator["chrf_examples"] += 1
+                language_accumulator["chrf_examples"] += 1
+                accumulator["chrf_sum"] += score
+                language_accumulator["chrf_sum"] += score
+        if suite.requires_code_sandbox and code_sandbox is not None:
+            sandbox = code_sandbox.run(generated, record["test_cases"])
+            row["sandbox_status"] = sandbox.status
+            for target_accumulator in (accumulator, language_accumulator):
+                target_accumulator["code_sandbox_attempts"] += 1
+                if sandbox.status not in {"ok", "timeout"}:
+                    target_accumulator["code_sandbox_errors"] += 1
+            if sandbox.status in {"ok", "timeout"}:
+                row["code_execution_ok"] = sandbox.execution_ok
+                row["unit_test_pass_rate"] = sandbox.unit_test_pass_rate
+                for target_accumulator in (accumulator, language_accumulator):
+                    target_accumulator["code_execution_examples"] += 1
+                    if sandbox.execution_ok:
+                        target_accumulator["code_execution_passes"] += 1
+                    target_accumulator["unit_test_passes"] += sandbox.passed_tests
+                    target_accumulator["unit_test_total"] += sandbox.total_tests
+        per_example.append(row)
+        total += 1
+
+    if total == 0:
+        raise EvaluationDatasetError("evaluation dataset has no eligible examples")
+    rating_report = _rating_summary(ratings, valid_ids, suite)
+    rating_report["source_sha256"] = (
+        None if human_ratings_path is None else _sha256_file(human_ratings_path)
+    )
+    for example in per_example:
+        example_scores = rating_report["per_example_mean"].get(example["id"])
+        if example_scores is not None:
+            example["human_rubric_mean"] = example_scores
+            for accumulator in (
+                accumulators["overall"],
+                accumulators[example["language"]],
+            ):
+                _add_human_scores(accumulator, [example_scores])
+
+    summary = {
+        "overall": _finalize_accumulator(accumulators["overall"]),
+        "per_language": {
+            language: _finalize_accumulator(accumulator)
+            for language, accumulator in sorted(accumulators.items())
+            if language != "overall"
+        },
+    }
+    checkpoint_report = {
+        "file_name": checkpoint_source.name,
+        "sha256": _sha256_file(checkpoint_source),
+        "step": loaded.step,
+        "model_config": {
+            "vocab_size": loaded.model_config.vocab_size,
+            "context_length": loaded.model_config.context_length,
+            "d_model": loaded.model_config.d_model,
+            "num_layers": loaded.model_config.num_layers,
+            "num_heads": loaded.model_config.num_heads,
+        },
+    }
+    sandbox_report: dict[str, Any] = {
+        "enabled": code_sandbox is not None,
+        "protocol": "puzzel-code-sandbox-json-v1",
+    }
+    if code_sandbox is not None:
+        launcher = Path(code_sandbox.command[0])
+        sandbox_report["launcher"] = launcher.name
+        sandbox_report["launcher_sha256"] = (
+            _sha256_file(launcher) if launcher.is_file() else None
+        )
+    return {
+        "format": "puzzel-evaluation-report-v1",
+        "suite": suite.name,
+        "task": suite.task,
+        "suite_spec_sha256": _sha256_file(suite.source_path),
+        "dataset": {
+            "file_name": dataset_source.name,
+            "sha256": _sha256_file(dataset_source),
+            "examples_evaluated": total,
+            "partition_counts": dict(accumulators["overall"]["partition_counts"]),
+        },
+        "checkpoint": checkpoint_report,
+        "run": {
+            "device": str(resolved_device),
+            "decoding": "greedy",
+            "max_new_tokens": requested_new_tokens,
+            "max_examples_cap": max_examples,
+            "code_sandbox": sandbox_report,
+            "training_metrics": _read_training_metrics(training_metrics_path),
+        },
+        "metric_directions": suite.metric_directions,
+        "metrics": summary,
+        "human_ratings": {
+            key: value for key, value in rating_report.items() if key != "per_example_mean"
+        },
+        "examples": per_example,
+        "limitations": [
+            "Automatic metrics are diagnostics and are not capability claims.",
+            "Exact-match metrics do not infer semantic or symbolic equivalence.",
+            "Code execution is not run unless an explicitly configured external sandbox launcher is supplied.",
+            "Creative-writing quality requires human rubric ratings; no external or AI judge is used.",
+        ],
+    }
diff --git a/puzzel/evaluation/sandbox.py b/puzzel/evaluation/sandbox.py
new file mode 100644
index 0000000..1a6fd0e
--- /dev/null
+++ b/puzzel/evaluation/sandbox.py
@@ -0,0 +1,123 @@
+"""Opt-in adapter for a user-supplied, externally isolated code sandbox."""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+import subprocess
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Sequence
+
+@dataclass(frozen=True, slots=True)
+class SandboxResult:
+    execution_ok: bool
+    passed_tests: int
+    total_tests: int
+    status: str
+
+    @property
+    def unit_test_pass_rate(self) -> float:
+        if self.total_tests <= 0:
+            return 0.0
+        return self.passed_tests / self.total_tests
+
+
+class CodeSandboxCommand:
+    """Call a user-installed sandbox launcher without shell interpolation.
+
+    The launcher receives one JSON object on stdin with ``code`` and
+    ``test_cases``. It must print one JSON object containing ``execution_ok``,
+    ``passed_tests``, and ``total_tests``. This adapter enforces a wall-clock
+    timeout and caps parsed result counts; the launcher, not this subprocess
+    wrapper, must provide the actual OS/container isolation boundary.
+    """
+
+    def __init__(
+        self,
+        command: str | Path | Sequence[str],
+        *,
+        timeout_seconds: float = 10.0,
+    ) -> None:
+        if isinstance(command, (str, Path)):
+            normalized = (str(command),)
+        else:
+            normalized = tuple(str(part) for part in command)
+        if not normalized or any(not part for part in normalized):
+            raise ValueError("sandbox command must contain a non-empty executable")
+        if not math.isfinite(timeout_seconds) or timeout_seconds <= 0:
+            raise ValueError("sandbox timeout must be positive and finite")
+        self.command = normalized
+        self.timeout_seconds = timeout_seconds
+
+    def run(
+        self,
+        code: str,
+        test_cases: list[dict[str, Any]],
+        *,
+        working_directory: str | Path | None = None,
+    ) -> SandboxResult:
+        """Run code through the configured launcher; never evaluates code here."""
+        payload = json.dumps(
+            {"code": code, "test_cases": test_cases},
+            ensure_ascii=False,
+            allow_nan=False,
+        )
+        if working_directory is None:
+            with tempfile.TemporaryDirectory(prefix="puzzel-eval-sandbox-") as temp_dir:
+                return self._invoke(payload, len(test_cases), Path(temp_dir))
+        return self._invoke(payload, len(test_cases), Path(working_directory))
+
+    def _invoke(
+        self,
+        payload: str,
+        test_count: int,
+        working_directory: Path,
+    ) -> SandboxResult:
+        try:
+            completed = subprocess.run(
+                self.command,
+                input=payload,
+                text=True,
+                encoding="utf-8",
+                errors="strict",
+                capture_output=True,
+                timeout=self.timeout_seconds,
+                cwd=working_directory,
+                env={
+                    "PATH": os.environ.get("PATH", ""),
+                    "LANG": "C.UTF-8",
+                    "LC_ALL": "C.UTF-8",
+                },
+                shell=False,
+                check=False,
+            )
+        except subprocess.TimeoutExpired:
+            return SandboxResult(False, 0, test_count, "timeout")
+        except (OSError, UnicodeError) as exc:
+            return SandboxResult(False, 0, test_count, f"launcher_error:{type(exc).__name__}")
+
+        if completed.returncode != 0:
+            return SandboxResult(False, 0, test_count, "launcher_failed")
+        try:
+            result = json.loads(completed.stdout)
+        except json.JSONDecodeError:
+            return SandboxResult(False, 0, test_count, "invalid_launcher_output")
+        if not isinstance(result, dict):
+            return SandboxResult(False, 0, test_count, "invalid_launcher_output")
+        execution_ok = result.get("execution_ok")
+        passed_tests = result.get("passed_tests")
+        reported_total = result.get("total_tests")
+        if (
+            not isinstance(execution_ok, bool)
+            or not isinstance(passed_tests, int)
+            or isinstance(passed_tests, bool)
+            or not isinstance(reported_total, int)
+            or isinstance(reported_total, bool)
+            or reported_total != test_count
+            or not 0 <= passed_tests <= test_count
+        ):
+            return SandboxResult(False, 0, test_count, "invalid_launcher_result")
+        return SandboxResult(execution_ok, passed_tests, test_count, "ok")
diff --git a/puzzel/evaluation/specs.py b/puzzel/evaluation/specs.py
new file mode 100644
index 0000000..7970921
--- /dev/null
+++ b/puzzel/evaluation/specs.py
@@ -0,0 +1,288 @@
+"""Evaluation-suite specifications and strict local JSONL validation."""
+
+from __future__ import annotations
+
+import json
+import tomllib
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterator
+
+from puzzel.languages import MULTILINGUAL_LANGUAGE_CODES
+
+SUITE_NAMES = (
+    "multilingual_conversation",
+    "general_knowledge",
+    "programming",
+    "mathematics",
+    "reasoning",
+    "translation",
+    "creative_writing",
+)
+_ALLOWED_PARTITIONS = {"dev", "test"}
+_ALLOWED_MESSAGE_ROLES = {"system", "user", "assistant"}
+_ALLOWED_METRIC_DIRECTIONS = {"higher", "lower"}
+
+
+class EvaluationDatasetError(ValueError):
+    """Raised for invalid evaluation records or dataset provenance."""
+
+
+@dataclass(frozen=True, slots=True)
+class SuiteSpec:
+    """A loaded capability-specific evaluation schema and metric policy."""
+
+    name: str
+    task: str
+    description: str
+    required_fields: tuple[str, ...]
+    reference_field: str
+    answer_field: str
+    max_new_tokens: int
+    requires_code_sandbox: bool
+    rubric_categories: tuple[str, ...]
+    metric_directions: dict[str, str]
+    source_path: Path
+
+
+def load_suite_spec(
+    name: str,
+    *,
+    directory: str | Path | None = None,
+) -> SuiteSpec:
+    """Load a reviewed suite definition from the repository's TOML specs."""
+    if name not in SUITE_NAMES:
+        raise ValueError(f"unknown evaluation suite {name!r}; choose one of {', '.join(SUITE_NAMES)}")
+    spec_dir = (
+        Path(directory)
+        if directory is not None
+        else Path(__file__).resolve().parents[2] / "configs" / "evaluation"
+    )
+    source = spec_dir / f"{name}.toml"
+    try:
+        payload = tomllib.loads(source.read_text(encoding="utf-8"))
+    except (OSError, tomllib.TOMLDecodeError) as exc:
+        raise ValueError(f"cannot read evaluation suite spec {source}: {exc}") from exc
+    if payload.get("format") != "puzzel-evaluation-suite-v1":
+        raise ValueError(f"unsupported evaluation suite spec format in {source}")
+    if payload.get("name") != name:
+        raise ValueError(f"suite spec name does not match filename: {source}")
+
+    required_fields = payload.get("required_fields")
+    directions = payload.get("metrics")
+    rubric_categories = payload.get("rubric_categories", [])
+    max_new_tokens = payload.get("max_new_tokens")
+    if (
+        not isinstance(required_fields, list)
+        or not required_fields
+        or any(not isinstance(field, str) or not field for field in required_fields)
+    ):
+        raise ValueError(f"required_fields is malformed in {source}")
+    if (
+        not isinstance(directions, dict)
+        or not directions
+        or any(direction not in _ALLOWED_METRIC_DIRECTIONS for direction in directions.values())
+    ):
+        raise ValueError(f"metric directions are malformed in {source}")
+    if not isinstance(rubric_categories, list) or any(
+        not isinstance(category, str) or not category for category in rubric_categories
+    ):
+        raise ValueError(f"rubric_categories is malformed in {source}")
+    if (
+        not isinstance(max_new_tokens, int)
+        or isinstance(max_new_tokens, bool)
+        or max_new_tokens <= 0
+    ):
+        raise ValueError(f"max_new_tokens must be positive in {source}")
+    if not isinstance(payload.get("requires_code_sandbox"), bool):
+        raise ValueError(f"requires_code_sandbox must be a boolean in {source}")
+
+    return SuiteSpec(
+        name=name,
+        task=str(payload.get("task", "")),
+        description=str(payload.get("description", "")),
+        required_fields=tuple(required_fields),
+        reference_field=str(payload.get("reference_field", "")),
+        answer_field=str(payload.get("answer_field", "")),
+        max_new_tokens=max_new_tokens,
+        requires_code_sandbox=payload["requires_code_sandbox"],
+        rubric_categories=tuple(rubric_categories),
+        metric_directions=dict(directions),
+        source_path=source,
+    )
+
+
+def validate_record(record: Any, spec: SuiteSpec, *, line_number: int) -> dict[str, Any]:
+    """Validate one record and normalize the spelling alias for ``license``."""
+    prefix = f"{spec.name} JSONL line {line_number}"
+    if not isinstance(record, dict):
+        raise EvaluationDatasetError(f"{prefix}: record must be a JSON object")
+    normalized = dict(record)
+    if "license" not in normalized and isinstance(normalized.get("licence"), str):
+        normalized["license"] = normalized["licence"]
+    missing = [field for field in spec.required_fields if field not in normalized]
+    if missing:
+        raise EvaluationDatasetError(f"{prefix}: missing required fields {missing}")
+
+    for field in ("id", "source", "license"):
+        value = normalized.get(field)
+        if not isinstance(value, str) or not value.strip():
+            raise EvaluationDatasetError(f"{prefix}: {field} must be a non-empty string")
+    if normalized.get("language") not in MULTILINGUAL_LANGUAGE_CODES:
+        raise EvaluationDatasetError(
+            f"{prefix}: language must be one of {', '.join(MULTILINGUAL_LANGUAGE_CODES)}"
+        )
+    if normalized.get("partition") not in _ALLOWED_PARTITIONS:
+        raise EvaluationDatasetError(
+            f"{prefix}: partition must be 'dev' or 'test'; training data is not accepted"
+        )
+
+    for field in (
+        "prompt",
+        "reference",
+        "reference_code",
+        "reference_translation",
+        "source_text",
+    ):
+        if field in normalized and not isinstance(normalized[field], str):
+            raise EvaluationDatasetError(f"{prefix}: {field} must be a string")
+    for field in ("accepted_answers", "expected_answer"):
+        if field not in normalized:
+            continue
+        value = normalized[field]
+        if isinstance(value, str):
+            valid = bool(value.strip())
+        elif isinstance(value, list):
+            valid = bool(value) and all(isinstance(answer, str) and answer.strip() for answer in value)
+        else:
+            valid = False
+        if not valid:
+            raise EvaluationDatasetError(
+                f"{prefix}: {field} must be a non-empty string or list of strings"
+            )
+
+    if "messages" in normalized:
+        messages = normalized["messages"]
+        if not isinstance(messages, list) or not messages:
+            raise EvaluationDatasetError(f"{prefix}: messages must be a non-empty array")
+        for index, message in enumerate(messages):
+            if (
+                not isinstance(message, dict)
+                or message.get("role") not in _ALLOWED_MESSAGE_ROLES
+                or not isinstance(message.get("content"), str)
+                or not message["content"].strip()
+            ):
+                raise EvaluationDatasetError(
+                    f"{prefix}: message {index} needs a supported role and non-empty content"
+                )
+        if not any(message["role"] == "user" for message in messages):
+            raise EvaluationDatasetError(f"{prefix}: conversation needs at least one user message")
+        if messages[-1]["role"] != "user":
+            raise EvaluationDatasetError(f"{prefix}: final conversation message must be from user")
+
+    if spec.name == "translation":
+        source_language = normalized.get("source_language")
+        target_language = normalized.get("target_language")
+        if source_language not in MULTILINGUAL_LANGUAGE_CODES:
+            raise EvaluationDatasetError(f"{prefix}: unsupported source_language")
+        if target_language not in MULTILINGUAL_LANGUAGE_CODES:
+            raise EvaluationDatasetError(f"{prefix}: unsupported target_language")
+        if source_language == target_language:
+            raise EvaluationDatasetError(f"{prefix}: source and target languages must differ")
+        if normalized["language"] != target_language:
+            raise EvaluationDatasetError(f"{prefix}: language must equal target_language")
+        if not normalized["source_text"].strip() or not normalized["reference_translation"].strip():
+            raise EvaluationDatasetError(f"{prefix}: translation source and reference must be non-empty")
+
+    if spec.name == "programming":
+        test_cases = normalized.get("test_cases")
+        if not isinstance(test_cases, list) or not test_cases:
+            raise EvaluationDatasetError(f"{prefix}: test_cases must be a non-empty array")
+        for index, test_case in enumerate(test_cases):
+            if not isinstance(test_case, dict) or not {
+                "input",
+                "expected_output",
+            }.issubset(test_case):
+                raise EvaluationDatasetError(
+                    f"{prefix}: test case {index} needs input and expected_output fields"
+                )
+
+    if spec.name == "multilingual_conversation":
+        if not normalized["reference"].strip():
+            raise EvaluationDatasetError(f"{prefix}: reference must be non-empty")
+
+    if spec.name == "general_knowledge" and "accepted_answers" not in normalized:
+        raise EvaluationDatasetError(f"{prefix}: accepted_answers are required")
+    if spec.name in {"mathematics", "reasoning"} and "expected_answer" not in normalized:
+        raise EvaluationDatasetError(f"{prefix}: expected_answer is required")
+    if spec.name == "programming" and not normalized["reference_code"].strip():
+        raise EvaluationDatasetError(f"{prefix}: reference_code must be non-empty")
+    if spec.name == "creative_writing":
+        if not normalized["prompt"].strip():
+            raise EvaluationDatasetError(f"{prefix}: prompt must be non-empty")
+    elif "prompt" in normalized and not normalized["prompt"].strip():
+        raise EvaluationDatasetError(f"{prefix}: prompt must be non-empty")
+    return normalized
+
+
+def iter_evaluation_records(
+    path: str | Path,
+    spec: SuiteSpec,
+) -> Iterator[dict[str, Any]]:
+    """Stream-validate UTF-8 JSONL examples and reject duplicate example IDs."""
+    source = Path(path)
+    seen_ids: set[str] = set()
+    try:
+        with source.open("r", encoding="utf-8-sig") as stream:
+            for line_number, line in enumerate(stream, start=1):
+                if not line.strip():
+                    continue
+                try:
+                    raw_record = json.loads(line)
+                except json.JSONDecodeError as exc:
+                    raise EvaluationDatasetError(
+                        f"{source}:{line_number}: invalid JSON: {exc.msg}"
+                    ) from exc
+                record = validate_record(raw_record, spec, line_number=line_number)
+                if record["id"] in seen_ids:
+                    raise EvaluationDatasetError(
+                        f"{source}:{line_number}: duplicate example id {record['id']!r}"
+                    )
+                seen_ids.add(record["id"])
+                yield record
+    except (OSError, UnicodeError) as exc:
+        raise EvaluationDatasetError(f"cannot read evaluation dataset {source}: {exc}") from exc
+
+
+def validate_ratings_record(
+    record: Any,
+    *,
+    path: str | Path,
+    line_number: int,
+    categories: tuple[str, ...],
+) -> dict[str, Any]:
+    """Validate one independent human-rating record (scores are 1 through 5)."""
+    prefix = f"ratings JSONL line {line_number} in {path}"
+    if not isinstance(record, dict):
+        raise EvaluationDatasetError(f"{prefix}: record must be an object")
+    example_id = record.get("id")
+    rater_id = record.get("rater_id")
+    scores = record.get("scores")
+    if not isinstance(example_id, str) or not example_id.strip():
+        raise EvaluationDatasetError(f"{prefix}: id must be a non-empty string")
+    if not isinstance(rater_id, str) or not rater_id.strip():
+        raise EvaluationDatasetError(f"{prefix}: rater_id must be a non-empty string")
+    if not isinstance(scores, dict) or not scores:
+        raise EvaluationDatasetError(f"{prefix}: scores must be a non-empty object")
+    if set(scores) - set(categories):
+        raise EvaluationDatasetError(f"{prefix}: scores contain an unknown rubric category")
+    for category, score in scores.items():
+        if (
+            not isinstance(score, (int, float))
+            or isinstance(score, bool)
+            or not 1 <= score <= 5
+        ):
+            raise EvaluationDatasetError(
+                f"{prefix}: score for {category!r} must be between 1 and 5"
+            )
+    return {"id": example_id, "rater_id": rater_id, "scores": scores}
